{"v":1,"lang":"en","dialogues":[{"id":"d0001","w":1,"title_ko":"첫 인사","scene":"sounds_hello","user":"B","lines":[{"s":"A","en":"Hello, Min.","ko":"안녕하세요, 민.","say":"","words":["w0002","w0510"],"o":14},{"s":"B","en":"Hi, Anna.","ko":"안녕, 애나.","say":"","words":["w0001","w0512"],"o":14},{"s":"A","en":"Sit, please.","ko":"앉아 주세요.","say":"","words":["w0015","w0020"],"o":14},{"s":"B","en":"Thanks.","ko":"고마워요.","say":"","words":["w0004"],"o":14}]},{"id":"d0002","w":2,"title_ko":"이름 묻기","scene":"sounds_name","user":"B","lines":[{"s":"A","en":"Hello. What's your name?","ko":"안녕하세요. 이름이 뭐예요?","say":"","words":["w0002","w0026","w0032","w0033"],"o":24},{"s":"B","en":"My name is Min.","ko":"제 이름은 민이에요.","say":"","words":["w0025","w0026","w0027","w0510"],"o":24},{"s":"A","en":"Hi, Min. My name is Anna.","ko":"안녕, 민. 제 이름은 애나예요.","say":"","words":["w0001","w0025","w0026","w0027","w0510","w0512"],"o":24},{"s":"B","en":"Hi, Anna.","ko":"안녕, 애나.","say":"","words":["w0001","w0512"],"o":24}]},{"id":"d0003","w":3,"title_ko":"집에 온 손님","scene":"sounds_numbers","user":"B","lines":[{"s":"A","en":"Hello, Min. Welcome home.","ko":"안녕하세요, 민. 집에 온 걸 환영해요.","say":"","words":["w0002","w0021","w0078","w0510"],"o":34},{"s":"B","en":"Thank you, Anna. It's a big home.","ko":"감사해요, 애나. 큰 집이에요.","say":"","words":["w0014","w0049","w0069","w0070","w0073","w0078","w0512"],"o":34},{"s":"A","en":"Sit, please. Cake?","ko":"앉아 주세요. 케이크 드실래요?","say":"","words":["w0015","w0020","w0077"],"o":34},{"s":"B","en":"Yes, please. Thank you.","ko":"네, 부탁해요. 감사해요.","say":"","words":["w0006","w0020","w0049","w0073"],"o":34}]},{"id":"d0004","w":4,"title_ko":"처음 만난 사이","scene":"spell_name","user":"B","lines":[{"s":"A","en":"Hi. I'm Anna. What's your name?","ko":"안녕하세요. 저는 애나예요. 이름이 뭐예요?","say":"","words":["w0001","w0026","w0032","w0033","w0090","w0512"],"o":44},{"s":"B","en":"I'm Min. Where are you from?","ko":"저는 민이에요. 어디에서 오셨어요?","say":"","words":["w0049","w0087","w0088","w0089","w0090","w0510"],"o":44},{"s":"A","en":"I'm from Canada. Where are you from?","ko":"캐나다에서 왔어요. 어디에서 오셨어요?","say":"","words":["w0049","w0087","w0088","w0089","w0090","w0517"],"o":44},{"s":"B","en":"I'm from Korea.","ko":"한국에서 왔어요.","say":"","words":["w0089","w0090","w0516"],"o":44}]},{"id":"d0005","w":5,"title_ko":"처음 만난 인사","scene":"intro_family","user":"B","lines":[{"s":"A","en":"Hi, I'm Anna. Nice to meet you.","ko":"안녕하세요, 저는 애나예요. 만나서 반가워요.","say":"","words":["w0001","w0049","w0090","w0111","w0112","w0113","w0512"],"o":54},{"s":"B","en":"Nice to meet you, Anna. I'm Min.","ko":"만나서 반가워요, 애나. 저는 민이에요.","say":"","words":["w0049","w0090","w0111","w0112","w0113","w0510","w0512"],"o":54},{"s":"A","en":"How are you, Min?","ko":"민, 잘 지내세요?","say":"","words":["w0049","w0079","w0088","w0510"],"o":54},{"s":"B","en":"I'm fine, thanks. And you?","ko":"잘 지내요, 고마워요. 어떠세요?","say":"","words":["w0004","w0049","w0090","w0110","w0115"],"o":54}]},{"id":"d0006","w":6,"title_ko":"새 전화기","scene":"things_colours","user":"B","lines":[{"s":"A","en":"Oh, what's that?","ko":"아, 그게 뭐예요?","say":"","words":["w0032","w0072","w0091"],"o":64},{"s":"B","en":"It's my new phone.","ko":"제 새 전화기예요.","say":"","words":["w0025","w0069","w0084","w0147"],"o":64},{"s":"A","en":"Nice! What colour is it?","ko":"멋지네요! 무슨 색이에요?","say":"","words":["w0027","w0112","w0141","w0152","w0154"],"o":64},{"s":"B","en":"It's blue.","ko":"파란색이에요.","say":"","words":["w0069","w0155"],"o":64}]},{"id":"d0007","w":7,"title_ko":"하키 좋아하세요?","scene":"likes_hobbies","user":"B","lines":[{"s":"A","en":"Do you like hockey?","ko":"하키 좋아하세요?","say":"","words":["w0049","w0080","w0175","w0186"],"o":74},{"s":"B","en":"Yes, I do. I love it. And you?","ko":"네, 좋아해요. 저는 아주 좋아해요. 어떠세요?","say":"","words":["w0006","w0046","w0049","w0080","w0105","w0110","w0152"],"o":74},{"s":"A","en":"No, I don't. But I like soccer.","ko":"아니요, 안 좋아해요. 하지만 축구는 좋아해요.","say":"","words":["w0007","w0105","w0175","w0176","w0178","w0187"],"o":74},{"s":"B","en":"Soccer is fun!","ko":"축구는 재미있어요!","say":"","words":["w0027","w0181","w0187"],"o":74}]},{"id":"d0008","w":8,"title_ko":"카페에서 주문","scene":"cafe_order","user":"B","lines":[{"s":"A","en":"Hi. Welcome.","ko":"안녕하세요. 어서 오세요.","say":"","words":["w0001","w0021"],"o":84},{"s":"B","en":"Hi. Can I have a coffee, please?","ko":"안녕하세요. 커피 한 잔 주실 수 있어요?","say":"","words":["w0001","w0020","w0070","w0105","w0114","w0210","w0216"],"o":84},{"s":"A","en":"Medium or large?","ko":"중간 사이즈요, 큰 사이즈요?","say":"","words":["w0222","w0230","w0231"],"o":84},{"s":"B","en":"Medium, please.","ko":"중간 사이즈로 주세요.","say":"","words":["w0020","w0230"],"o":84},{"s":"A","en":"With milk and sugar?","ko":"우유와 설탕을 넣을까요?","say":"","words":["w0110","w0213","w0215","w0223"],"o":84},{"s":"B","en":"Milk, no sugar, please.","ko":"우유만 넣고 설탕은 빼 주세요.","say":"","words":["w0007","w0020","w0213","w0215"],"o":84},{"s":"A","en":"For here or to go?","ko":"드시고 가세요, 가져가세요?","say":"","words":["w0103","w0111","w0222","w0227","w0228"],"o":84},{"s":"B","en":"To go, please.","ko":"포장해 주세요.","say":"","words":["w0020","w0111","w0228"],"o":84},{"s":"A","en":"Can I have your name, please?","ko":"성함 좀 알려 주실 수 있어요?","say":"","words":["w0020","w0026","w0033","w0105","w0114","w0216"],"o":84},{"s":"B","en":"It's Min. Thank you.","ko":"민이에요. 감사해요.","say":"","words":["w0049","w0069","w0073","w0510"],"o":84}]},{"id":"d0009","w":9,"title_ko":"하루 일과 이야기","scene":"daily_time","user":"B","lines":[{"s":"A","en":"Hi, Min. What time do you get up on Monday?","ko":"안녕하세요, 민. 월요일에는 몇 시에 일어나요?","say":"","words":["w0001","w0049","w0080","w0141","w0243","w0245","w0258","w0259","w0265","w0510"],"o":94},{"s":"B","en":"I get up at six. What time do you get up?","ko":"저는 여섯 시에 일어나요. 몇 시에 일어나요?","say":"","words":["w0036","w0049","w0080","w0104","w0105","w0141","w0243","w0258","w0259"],"o":94},{"s":"A","en":"I get up at seven. What time do you have breakfast?","ko":"저는 일곱 시에 일어나요. 몇 시에 아침을 먹어요?","say":"","words":["w0037","w0049","w0080","w0104","w0105","w0114","w0141","w0243","w0258","w0259","w0260"],"o":94},{"s":"B","en":"I have breakfast at seven. Do you have breakfast every day?","ko":"저는 일곱 시에 아침을 먹어요. 매일 아침을 먹어요?","say":"","words":["w0037","w0049","w0080","w0104","w0105","w0114","w0252","w0257","w0260"],"o":94},{"s":"A","en":"Yes, I do. What time do you get up on Saturday?","ko":"네, 먹어요. 토요일에는 몇 시에 일어나요?","say":"","words":["w0006","w0049","w0080","w0105","w0141","w0243","w0250","w0258","w0259","w0265"],"o":94},{"s":"B","en":"I get up at nine on Saturday.","ko":"저는 토요일에는 아홉 시에 일어나요.","say":"","words":["w0039","w0104","w0105","w0250","w0258","w0259","w0265"],"o":94},{"s":"A","en":"Nice. I get up at ten.","ko":"멋지네요. 저는 열 시에 일어나요.","say":"","words":["w0040","w0104","w0105","w0112","w0258","w0259"],"o":94}]},{"id":"d0010","w":10,"title_ko":"화장실이 어디예요?","scene":"where_is","user":"B","lines":[{"s":"A","en":"Excuse me. Is there a washroom near here?","ko":"저기요. 이 근처에 화장실이 있어요?","say":"","words":["w0027","w0070","w0094","w0095","w0103","w0277","w0284","w0294"],"o":104},{"s":"B","en":"Yes, there is. It's in the library.","ko":"네, 있어요. 도서관 안에 있어요.","say":"","words":["w0006","w0027","w0069","w0142","w0266","w0284","w0290"],"o":104},{"s":"A","en":"Where is the library?","ko":"도서관이 어디예요?","say":"","words":["w0027","w0087","w0142","w0290"],"o":104},{"s":"B","en":"It's on Main Street, next to the bank.","ko":"메인 스트리트에, 은행 옆에 있어요.","say":"","words":["w0069","w0111","w0142","w0265","w0280","w0286","w0296","w0610"],"o":104},{"s":"A","en":"Is it far?","ko":"멀어요?","say":"","words":["w0027","w0152","w0295"],"o":104},{"s":"B","en":"No, it's near. It's on the left.","ko":"아니요, 가까워요. 왼쪽에 있어요.","say":"","words":["w0007","w0069","w0142","w0265","w0294","w0299"],"o":104},{"s":"A","en":"Thank you.","ko":"감사해요.","say":"","words":["w0049","w0073"],"o":104},{"s":"B","en":"Bye.","ko":"잘 가요.","say":"","words":["w0003"],"o":104}]},{"id":"d0011","w":11,"title_ko":"계산대에서","scene":"how_much","user":"B","lines":[{"s":"A","en":"Hello. That's $11.30.","ko":"안녕하세요. 11달러 30센트예요.","say":"Hello. That's eleven thirty.","words":["w0002","w0051","w0061","w0144"],"o":114},{"s":"B","en":"Can I pay with debit?","ko":"체크카드로 계산해도 될까요?","say":"","words":["w0105","w0216","w0223","w0318","w0321"],"o":114},{"s":"A","en":"Yes. Debit or credit?","ko":"네. 체크카드예요, 신용카드예요?","say":"","words":["w0006","w0222","w0321","w0322"],"o":114},{"s":"B","en":"Debit, please.","ko":"체크카드로 부탁해요.","say":"","words":["w0020","w0321"],"o":114},{"s":"A","en":"Do you want a receipt?","ko":"영수증 드릴까요?","say":"","words":["w0049","w0070","w0080","w0217","w0326"],"o":114},{"s":"B","en":"Yes, please.","ko":"네, 부탁해요.","say":"","words":["w0006","w0020"],"o":114},{"s":"A","en":"Here is your receipt. Thank you.","ko":"영수증 여기 있어요. 감사해요.","say":"","words":["w0027","w0033","w0049","w0073","w0103","w0326"],"o":114},{"s":"B","en":"Thanks.","ko":"고마워요.","say":"","words":["w0004"],"o":114}]},{"id":"d0012","w":12,"title_ko":"못 알아들었을 때","scene":"ask_again","user":"B","lines":[{"s":"A","en":"Hi. Do you need help?","ko":"안녕하세요. 도움이 필요하세요?","say":"","words":["w0001","w0049","w0080","w0352","w0358"],"o":124},{"s":"B","en":"Sorry? Could you say that again, please?","ko":"네? 다시 한번 말씀해 주시겠어요?","say":"","words":["w0005","w0020","w0049","w0072","w0096","w0097","w0347"],"o":124},{"s":"A","en":"Do you need help?","ko":"도움이 필요하세요?","say":"","words":["w0049","w0080","w0352","w0358"],"o":124},{"s":"B","en":"Oh, yes. I need a bag. I speak a little English.","ko":"아, 네. 가방이 필요해요. 저는 영어를 조금 해요.","say":"","words":["w0006","w0009","w0070","w0091","w0098","w0099","w0105","w0358","w0369"],"o":124},{"s":"A","en":"No problem. I can help you. What colour?","ko":"문제없어요. 제가 도와드릴 수 있어요. 무슨 색이요?","say":"","words":["w0007","w0049","w0105","w0141","w0154","w0216","w0352","w0368"],"o":124},{"s":"B","en":"Blue, please. Could you speak slowly?","ko":"파란색으로 부탁해요. 천천히 말씀해 주시겠어요?","say":"","words":["w0020","w0049","w0098","w0155","w0347","w0366"],"o":124},{"s":"A","en":"Sure. Here is a blue bag.","ko":"그럼요. 파란 가방 여기 있어요.","say":"","words":["w0009","w0027","w0070","w0103","w0155","w0367"],"o":124},{"s":"B","en":"Thank you. How much is it?","ko":"감사해요. 얼마예요?","say":"","words":["w0027","w0049","w0073","w0079","w0152","w0311"],"o":124},{"s":"A","en":"It's $10.","ko":"10달러예요.","say":"It's ten dollars.","words":["w0040","w0069"],"o":124}]},{"id":"d0013","w":13,"title_ko":"오늘 일해요?","scene":"daily_life","user":"B","lines":[{"s":"A","en":"Hi, Min. Do you work today?","ko":"안녕하세요, 민. 오늘 일해요?","say":"","words":["w0001","w0049","w0080","w0253","w0380","w0510"],"o":134},{"s":"B","en":"No, I don't. I work on Monday and Friday.","ko":"아니요, 안 해요. 저는 월요일하고 금요일에 일해요.","say":"","words":["w0007","w0105","w0110","w0176","w0245","w0249","w0265","w0380"],"o":134},{"s":"A","en":"Do you cook dinner at home?","ko":"집에서 저녁을 요리해요?","say":"","words":["w0049","w0078","w0080","w0104","w0262","w0386"],"o":134},{"s":"B","en":"Yes, I usually cook dinner. Do you cook?","ko":"네, 보통 저녁을 요리해요. 요리해요?","say":"","words":["w0006","w0049","w0080","w0105","w0262","w0386","w0400"],"o":134},{"s":"A","en":"Sometimes. I often eat pizza.","ko":"가끔요. 저는 피자를 자주 먹어요.","say":"","words":["w0105","w0221","w0383","w0401","w0403"],"o":134},{"s":"B","en":"Do you drink coffee at night?","ko":"밤에 커피를 마셔요?","say":"","words":["w0024","w0049","w0080","w0104","w0210","w0384"],"o":134},{"s":"A","en":"No, I never drink coffee at night. I drink tea.","ko":"아니요, 밤에는 커피를 절대 안 마셔요. 차를 마셔요.","say":"","words":["w0007","w0024","w0104","w0105","w0210","w0211","w0384","w0402"],"o":134},{"s":"B","en":"Me too! I drink tea at night.","ko":"저도요! 저는 밤에 차를 마셔요.","say":"","words":["w0024","w0095","w0104","w0105","w0211","w0327","w0384"],"o":134}]},{"id":"d0014","w":14,"title_ko":"무슨 일을 해요?","scene":"jobs","user":"B","lines":[{"s":"A","en":"Hi, I'm Tom. What do you do?","ko":"안녕하세요, 저는 톰이에요. 무슨 일을 해요?","say":"","words":["w0001","w0049","w0080","w0090","w0141","w0515"],"o":144},{"s":"B","en":"I'm a student. I study English. What do you do?","ko":"저는 학생이에요. 영어를 공부해요. 무슨 일을 해요?","say":"","words":["w0049","w0070","w0080","w0090","w0099","w0105","w0141","w0382","w0415"],"o":144},{"s":"A","en":"I'm a chef. I work at a hotel.","ko":"저는 요리사예요. 호텔에서 일해요.","say":"","words":["w0070","w0090","w0104","w0105","w0380","w0420","w0422"],"o":144},{"s":"B","en":"Do you like your job?","ko":"직업이 마음에 들어요?","say":"","words":["w0033","w0049","w0080","w0175","w0414"],"o":144},{"s":"A","en":"Yes, I love it! The team is great.","ko":"네, 정말 좋아해요! 팀이 아주 좋아요.","say":"","words":["w0006","w0027","w0046","w0105","w0142","w0152","w0179","w0437"],"o":144},{"s":"B","en":"Is your boss nice?","ko":"상사는 친절해요?","say":"","words":["w0027","w0033","w0112","w0434"],"o":144},{"s":"A","en":"Yes, my boss is very nice.","ko":"네, 제 상사는 아주 친절해요.","say":"","words":["w0006","w0025","w0027","w0047","w0112","w0434"],"o":144},{"s":"B","en":"Great! I want a job in Canada.","ko":"좋네요! 저는 캐나다에서 일자리를 원해요.","say":"","words":["w0070","w0105","w0179","w0217","w0266","w0414","w0517"],"o":144}]},{"id":"d0015","w":15,"title_ko":"뭐 하고 있어요?","scene":"right_now","user":"B","lines":[{"s":"A","en":"Hi, Min. What are you doing?","ko":"안녕하세요, 민. 뭐 하고 있어요?","say":"","words":["w0001","w0049","w0080","w0088","w0141","w0510"],"o":154},{"s":"B","en":"I'm eating lunch.","ko":"점심을 먹고 있어요.","say":"","words":["w0090","w0261","w0383"],"o":154},{"s":"A","en":"What are you eating?","ko":"뭐 먹고 있어요?","say":"","words":["w0049","w0088","w0141","w0383"],"o":154},{"s":"B","en":"I'm eating soup and bread. Are you hungry?","ko":"수프하고 빵을 먹고 있어요. 배고파요?","say":"","words":["w0049","w0088","w0090","w0110","w0219","w0225","w0383","w0452"],"o":154},{"s":"A","en":"Yes, I'm hungry and tired.","ko":"네, 배고프고 피곤해요.","say":"","words":["w0006","w0090","w0110","w0451","w0452"],"o":154},{"s":"B","en":"Why are you tired?","ko":"왜 피곤해요?","say":"","words":["w0049","w0088","w0451","w0472"],"o":154},{"s":"A","en":"Because I work at night.","ko":"밤에 일하니까요.","say":"","words":["w0024","w0104","w0105","w0380","w0473"],"o":154},{"s":"B","en":"Call me tomorrow, please.","ko":"내일 전화해 주세요.","say":"","words":["w0020","w0095","w0254","w0456"],"o":154}]},{"id":"d0016","w":16,"title_ko":"카페에서 주문","scene":"s1_review","user":"B","lines":[{"s":"A","en":"Hi! Can I help you?","ko":"안녕하세요! 도와드릴까요?","say":"","words":["w0001","w0049","w0105","w0216","w0352"],"o":164},{"s":"B","en":"Yes, I'd like a coffee, please.","ko":"네, 커피 한 잔 주세요.","say":"","words":["w0006","w0020","w0070","w0175","w0209","w0210"],"o":164},{"s":"A","en":"Sure. Anything else?","ko":"그럼요. 또 필요한 거 있어요?","say":"","words":["w0367","w0494","w0495"],"o":164},{"s":"B","en":"Do you have any cake?","ko":"케이크 있어요?","say":"","words":["w0049","w0077","w0080","w0114","w0489"],"o":164},{"s":"A","en":"Yes, we have some cake. Which cake do you like?","ko":"네, 케이크가 있어요. 어느 케이크를 좋아해요?","say":"","words":["w0006","w0049","w0077","w0080","w0108","w0114","w0175","w0488","w0492"],"o":164},{"s":"B","en":"I like that cake. How much is it?","ko":"저 케이크가 좋아요. 얼마예요?","say":"","words":["w0027","w0072","w0077","w0079","w0105","w0152","w0175","w0311"],"o":164},{"s":"A","en":"The total is $9.50.","ko":"합계는 9달러 50센트예요.","say":"The total is nine fifty.","words":["w0027","w0039","w0063","w0142","w0325"],"o":164},{"s":"B","en":"Can I pay by card?","ko":"카드로 계산해도 될까요?","say":"","words":["w0105","w0216","w0318","w0320","w0398"],"o":164},{"s":"A","en":"Yes. Debit or credit?","ko":"네. 체크카드예요, 신용카드예요?","say":"","words":["w0006","w0222","w0321","w0322"],"o":164},{"s":"B","en":"Debit, please. Thanks a lot!","ko":"체크카드로 부탁해요. 정말 고마워요!","say":"","words":["w0004","w0020","w0070","w0321","w0490"],"o":164}]}]}
