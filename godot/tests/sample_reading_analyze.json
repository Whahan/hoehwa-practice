 "sentences": [
  {
   "i": 0,
   "text": "Running in the Rain"
  },
  {
   "i": 1,
   "text": "Every morning, Maya goes running along the river before work."
  },
  {
   "i": 2,
   "text": "Yesterday the sky was grey and a heavy rain began to fall, but she kept running anyway."
  },
  {
   "i": 3,
   "text": "Her neighbours thought she was reckless [or maybe brave]."
  },
  {
   "i": 4,
   "text": "She says the rhythm of her footsteps helps her untangle stubborn thoughts."
  },
  {
   "i": 5,
   "text": "By the time she reaches the old bridge, her worries have usually dissolved."
  }
 ],
