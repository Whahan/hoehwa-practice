{"v":1,"lang":"en","patterns":[{"id":"p_my_name","tpl":"My name is ___.","slots":[{"name":"x","pos":["propn"]}],"title_ko":"My name is ~ (제 이름은 ~예요)","grammar_ko":["영어는 'My name is' 바로 뒤에 이름이 와요.","한국어의 '은/는' 같은 조사는 필요 없어요."],"o":13,"examples":["s0009","s0010"]},{"id":"p_good_x","tpl":"Good ___.","slots":[{"name":"x","pos":["n"]}],"title_ko":"Good ~ (좋은 ~이에요)","grammar_ko":["'Good' 뒤에 때를 나타내는 말을 붙여 인사해요.","Good morning 은 아침에 하는 인사예요."],"o":14,"examples":["s0016","s0017"]},{"id":"p_it_is","tpl":"It is ___.","slots":[{"name":"x","pos":["num"]}],"title_ko":"It is ~ (그것은 ~예요)","grammar_ko":["영어는 'It is' 뒤에 말하려는 것이 와요.","한국어처럼 주어를 빼지 않고 'It' 을 꼭 써요."],"o":22,"examples":["s0102","s0103","s0104"]},{"id":"p_my_x_is","tpl":"My ___ is ___.","slots":[{"name":"x","pos":["n"]}],"title_ko":"My ~ is ~ (제 ~은 ~예요)","grammar_ko":["'My' 와 'is' 사이에 말하려는 대상을 넣어요.","번호는 숫자로 써도 소리 내어 읽을 때는 단어로 읽어요."],"o":23,"examples":["s0105","s0106","s0107"]},{"id":"p_greet_name","tpl":"Hello, ___.","slots":[{"name":"x","pos":["n","propn"]}],"title_ko":"Hello, ~ (안녕하세요, ~)","grammar_ko":["이름이나 호칭을 부를 때는 쉼표 뒤에 붙여요.","한국어의 '~야', '~씨' 같은 호칭 대신 이름만 써요."],"o":42,"examples":["s0401","s0402"]}]}
