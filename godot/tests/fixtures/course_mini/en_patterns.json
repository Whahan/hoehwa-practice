{"v":1,"lang":"en","patterns":[{"id":"p_greet","tpl":"Hello, ___.","slots":[{"name":"who","pos":["n"]}],"title_ko":"Hello (안녕하세요)","grammar_ko":["영어는 만날 때와 헤어질 때 인사가 다르다.","Hello는 누구에게나 쓸 수 있다."],"o":14,"examples":["s0001","s0002"]},{"id":"p_i_am","tpl":"I am ___.","slots":[{"name":"name","pos":["propn"]}],"title_ko":"I am ~ (저는 ~예요)","grammar_ko":["영어는 주어를 생략하지 않는다.","I 는 문장 어디서나 대문자로 쓴다."],"o":21,"examples":["s0014","s0015"]},{"id":"p_my_name_is","tpl":"My name is ___.","slots":[{"name":"name","pos":["propn"]}],"title_ko":"My name is ~ (제 이름은 ~예요)","grammar_ko":["이름 순서는 이름, 성이다.","my 는 '나의' 라는 뜻이다."],"o":24,"examples":["s0017","s0018"]},{"id":"p_what_is","tpl":"What is ___?","slots":[{"name":"thing","pos":["n"]}],"title_ko":"What is ~? (~이 뭐예요?)","grammar_ko":["의문사가 문장 맨 앞에 온다.","한국어와 어순이 반대다."],"o":24,"examples":["s0020","s0021"]},{"id":"p_plural_s","tpl":"___ + s","slots":[{"name":"noun","pos":["n"]}],"title_ko":"복수 -s","grammar_ko":["둘 이상이면 명사 끝에 s 를 붙인다.","한국어는 복수 표시를 거의 하지 않는다."],"o":33,"examples":["s0030"]}]}