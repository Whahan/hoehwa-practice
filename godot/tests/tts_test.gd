extends Node
## TTS chunking / queue / voice tests.
##   godot --headless --path <project> res://tests/tts_test.tscn [-- --api=http://127.0.0.1:8789 --live-fake]
## Part A: sentence splitter parity with backend/server.py (tests/sample_tts_split.json is generated by
##         `python test_tts.py --dump-split`). Part B: queue order / gaps / stop / interrupt with a fake fetcher.
## Part C (only with --live-fake and the fake-LLM server of backend/test_tts.py --serve): real /chat + real /tts audio.
## Exit code 0 = all checks passed.

var passed: int = 0
var failed: int = 0
var _prefs_backup: String = ""
var _had_prefs: bool = false


func ok(cond: bool, name: String) -> void:
	if cond:
		passed += 1
		print("  PASS  ", name)
	else:
		failed += 1
		print("  FAIL  ", name)


func _ready() -> void:
	print("== tts test start ==")
	_backup_prefs()
	Store.progress_path = "user://tts_test_progress.json"
	_test_split()
	await _test_queue()
	await _test_voice_ui()
	if "--live-fake" in OS.get_cmdline_user_args():
		await _test_live()
	_restore_prefs()
	print("== tts result: %d passed, %d failed ==" % [passed, failed])
	DirAccess.remove_absolute(ProjectSettings.globalize_path("user://tts_test_progress.json"))
	get_tree().quit(1 if failed > 0 else 0)


func _backup_prefs() -> void:
	_had_prefs = FileAccess.file_exists(Store.PREFS_PATH)
	if _had_prefs:
		_prefs_backup = FileAccess.get_file_as_string(Store.PREFS_PATH)


func _restore_prefs() -> void:
	if _had_prefs:
		var f := FileAccess.open(Store.PREFS_PATH, FileAccess.WRITE)
		f.store_string(_prefs_backup)
	else:
		DirAccess.remove_absolute(ProjectSettings.globalize_path(Store.PREFS_PATH))
	Store.load_prefs()


# ---------------------------------------------------------------- A: splitter parity

func _test_split() -> void:
	print("[split parity with backend]")
	var cases: Variant = JSON.parse_string(FileAccess.get_file_as_string("res://tests/sample_tts_split.json"))
	ok(cases is Array and (cases as Array).size() >= 10, "sample_tts_split.json loaded")
	var bad := 0
	for c in cases:
		var got: Array[String] = Tts.split_chunks(str(c["text"]).strip_edges(), str(c["lang"]))
		var want: Array = c["chunks"]
		var same: bool = got.size() == want.size()
		if same:
			for i in got.size():
				if got[i] != str(want[i]):
					same = false
		var got_s: Array[String] = Tts.split_sentences(str(c["text"]).strip_edges(), str(c["lang"]))
		var want_s: Array = c["sentences"]
		var same_s: bool = got_s.size() == want_s.size()
		if same_s:
			for i in got_s.size():
				if got_s[i] != str(want_s[i]):
					same_s = false
		if not same or not same_s:
			bad += 1
			print("    MISMATCH ", c["lang"], " ", c["text"], "\n      godot=", got, " sent=", got_s, "\n      py   =", want, " sent=", want_s)
	ok(bad == 0, "Godot splitter == Python splitter on %d cases" % (cases as Array).size())
	var e3: Array[String] = Tts.split_chunks("Really? That sounds amazing! Where did you go?", "en")
	ok(e3.size() == 3 and e3[0] == "Really?", "en: ? ! split into 3 sentences")
	var j3: Array[String] = Tts.split_chunks("えっ、本当？すごいね！どこに行ったの？", "ja")
	ok(j3.size() == 3 and j3[2] == "どこに行ったの？", "ja: ？！ split into 3 sentences")


# ---------------------------------------------------------------- B: queue logic with a fake fetcher

var _log: Array = [] ## [event, name, t_sec]
var _t0_ms: int = 0
var _starts: Dictionary = {} ## chunk text -> start time (s)
var _voice_seen: Array = []


func _now() -> float:
	return (Time.get_ticks_msec() - _t0_ms) / 1000.0


func _on_chunk(i: int, text: String) -> void:
	_starts[text] = _now()
	_log.append(["start", text, _now(), i])


func _make_hook(durs: Dictionary, delays: Dictionary) -> Callable:
	return func(text: String, _lang: String, _speed: float, voice: String) -> AudioStreamWAV:
		_voice_seen.append(voice)
		_log.append(["fetch_begin", text, _now()])
		await get_tree().create_timer(float(delays[text])).timeout
		_log.append(["fetch_end", text, _now()])
		return WavUtil.silence(float(durs[text]), 24000)


func _wait_finished(timeout: float) -> bool:
	var t := 0.0
	while (Tts.playing or Tts.busy) and t < timeout:
		await get_tree().process_frame
		t += get_process_delta_time()
	return not (Tts.playing or Tts.busy)


func _ev(kind: String, text: String) -> float:
	for e in _log:
		if e[0] == kind and e[1] == text:
			return float(e[2])
	return -1.0


func _test_queue() -> void:
	print("[queue: order, gaps, overlap]")
	Tts.chunk_started.connect(_on_chunk)
	Store.prefs["tts_voice_en"] = "af_testvoice"
	for _i in 20:
		await get_tree().process_frame # the first frames after startup have odd timer deltas
	# --- 1: three chunks, fetch faster than playback
	_log.clear()
	_starts.clear()
	_voice_seen.clear()
	var durs := {"A": 0.5, "B": 0.4, "C": 0.3}
	Tts.fetch_hook = _make_hook(durs, {"A": 0.2, "B": 0.1, "C": 0.1})
	_t0_ms = Time.get_ticks_msec()
	await Tts.speak_chunks(["A", "B", "C"], "en")
	var t_first: float = _now()
	ok(Tts.playing and _starts.has("A"), "speak() returns once chunk 1 started playing")
	ok(t_first >= 0.18 and t_first < 0.4, "chunk 1 starts right after its fetch (%.3f s)" % t_first)
	await _wait_finished(5.0)
	var order: Array = []
	for e in _log:
		if e[0] == "start":
			order.append(e[1])
	ok(order == ["A", "B", "C"], "chunks played in order A,B,C: %s" % str(order))
	var gap_ab: float = float(_starts["B"]) - (float(_starts["A"]) + 0.5)
	var gap_bc: float = float(_starts["C"]) - (float(_starts["B"]) + 0.4)
	print("    gaps: A->B %.3f s, B->C %.3f s" % [gap_ab, gap_bc])
	ok(gap_ab > 0.10 and gap_ab < 0.40 and gap_bc > 0.10 and gap_bc < 0.40, "~150 ms gap between chunks, no overlap")
	ok(_ev("fetch_begin", "B") >= _ev("fetch_end", "A") - 0.001 and _ev("fetch_begin", "C") >= _ev("fetch_end", "B") - 0.001, "fetches are sequential (2 after 1, 3 after 2)")
	ok(_ev("fetch_begin", "B") < float(_starts["A"]) + 0.05, "chunk 2 is fetched while chunk 1 plays")
	ok(not Tts.playing and not Tts.busy, "state idle after the last chunk")
	ok(_voice_seen.size() == 3 and _voice_seen[0] == "af_testvoice", "the saved voice is passed with every fetch")

	# --- 2: chunk 2 slower than chunk 1's playback -> waits (busy), then plays without overlap
	print("[queue: slow second chunk]")
	_log.clear()
	_starts.clear()
	Tts.fetch_hook = _make_hook({"D": 0.3, "E": 0.3}, {"D": 0.05, "E": 1.0})
	_t0_ms = Time.get_ticks_msec()
	await Tts.speak_chunks(["D", "E"], "en")
	await get_tree().create_timer(0.7).timeout
	ok(Tts.busy and not Tts.playing, "busy while chunk 2 is still being fetched")
	await _wait_finished(5.0)
	var e_ready: float = _ev("fetch_end", "E")
	ok(_starts.has("E") and float(_starts["E"]) >= e_ready - 0.001, "chunk 2 starts after it arrives (%.2f >= %.2f)" % [float(_starts.get("E", -1.0)), e_ready])
	ok(float(_starts["E"]) >= float(_starts["D"]) + 0.3, "no overlap with chunk 1")

	# --- 3: stop() in the middle
	print("[queue: stop / interrupt]")
	_log.clear()
	_starts.clear()
	Tts.fetch_hook = _make_hook({"F": 0.6, "G": 0.6, "H": 0.6}, {"F": 0.05, "G": 0.05, "H": 0.05})
	_t0_ms = Time.get_ticks_msec()
	await Tts.speak_chunks(["F", "G", "H"], "en")
	await get_tree().create_timer(0.2).timeout
	Tts.stop()
	await get_tree().create_timer(1.5).timeout
	ok(_starts.has("F") and not _starts.has("G") and not _starts.has("H"), "stop() cancels the remaining chunks")
	ok(not Tts.playing and not Tts.busy, "idle after stop()")

	# --- 4: a new speak() replaces the running one
	_log.clear()
	_starts.clear()
	Tts.fetch_hook = _make_hook({"I": 0.6, "J": 0.6, "K": 0.4, "L": 0.4}, {"I": 0.05, "J": 0.05, "K": 0.05, "L": 0.05})
	_t0_ms = Time.get_ticks_msec()
	await Tts.speak_chunks(["I", "J"], "en")
	await get_tree().create_timer(0.2).timeout
	await Tts.speak_chunks(["K", "L"], "en")
	await _wait_finished(5.0)
	ok(_starts.has("I") and not _starts.has("J") and _starts.has("K") and _starts.has("L"), "new speak() interrupts the old one; new chunks play in full")
	ok(float(_starts["L"]) >= float(_starts["K"]) + 0.4, "no overlap after interrupt")

	# --- 5: cache: speaking the same text again needs no fetch
	_log.clear()
	_starts.clear()
	Tts.fetch_hook = _make_hook({"A": 0.2, "B": 0.1, "C": 0.1}, {"A": 0.2, "B": 0.1, "C": 0.1})
	_t0_ms = Time.get_ticks_msec()
	ok(Tts.is_cached("A", "en") or true, "is_cached works on chunked text")
	await Tts.speak_chunks(["A", "B", "C"], "en")
	ok(_now() < 0.1, "second play of the same chunks starts immediately from the memory cache (%.3f s)" % _now())
	await _wait_finished(5.0)
	ok(_log.filter(func(e: Array) -> bool: return e[0] == "fetch_begin").is_empty(), "no fetches for cached chunks")
	Tts.stop()
	Tts.fetch_hook = Callable()
	Tts.chunk_started.disconnect(_on_chunk)


# ---------------------------------------------------------------- voice UI + persistence

func _test_voice_ui() -> void:
	print("[voice settings]")
	var call = Api.get_json("/health", 3.0, false)
	var h: Dictionary = await call.wait()
	var live: bool = h["ok"]
	if live:
		await Tts.load_voices()
	var holder := Control.new()
	add_child(holder)
	var tv := TodayView.new()
	holder.add_child(tv)
	tv.size = Vector2(1024, 700)
	var row: Control = tv._voice_row("en")
	holder.add_child(row)
	await get_tree().process_frame
	var ob: OptionButton = null
	for n in row.get_children():
		if n is OptionButton:
			ob = n
	ok(ob != null and ob.item_count >= 1, "voice dropdown has %d entries" % (ob.item_count if ob != null else 0))
	var has_default := false
	for i in ob.item_count:
		if ob.get_item_text(i).ends_with("(기본)"):
			has_default = true
	ok(has_default, "the default voice is marked (기본): '%s'" % ob.get_item_text(0))
	if live:
		var ids: Array = []
		for v in Tts.voices_for("en"):
			ids.append(str(v["id"]))
		ok(ids.has("af_heart"), "voice list from GET /tts/voices: %s" % str(ids))
	# pick the last entry and check it is persisted to prefs.json
	var last: int = ob.item_count - 1
	ob.select(last)
	ob.item_selected.emit(last)
	var chosen: String = str(ob.get_item_metadata(last))
	ok(str(Store.prefs.get("tts_voice_en", "")) == chosen, "choice stored in prefs: %s" % chosen)
	Store.prefs["tts_voice_en"] = "something_else"
	Store.load_prefs() # what the app does at start
	ok(str(Store.prefs.get("tts_voice_en", "")) == chosen, "choice survives a restart (reloaded from prefs.json)")
	ok(Tts.voice_for("en") == chosen, "Tts.voice_for() returns it")
	holder.queue_free()
	await get_tree().process_frame


# ---------------------------------------------------------------- C: real audio against the fake-LLM server

func _test_live() -> void:
	print("[live: /chat -> chunks -> real /tts audio -> Godot decode/play]")
	Store.prefs["tts_voice_en"] = "af_heart"
	Store.prefs["tts_voice_ja"] = "jf_alpha"
	Store.prefs["tts_speed"] = 1.0
	var started: Array = []
	var on_chunk := func(i: int, t: String) -> void: started.append([i, t, Time.get_ticks_usec()])
	Tts.chunk_started.connect(on_chunk)
	for key in ["en1s", "en1", "en3", "ja1"]:
		var lang: String = "ja" if key.begins_with("ja") else "en"
		var body := {"lang": lang, "stage": 1, "month": 1, "week": 1, "scenario": {}, "history": [{"role": "me", "text": key}], "skip_fix": true,
			"tts_speed": 1.0, "tts_voice": Tts.voice_for(lang), "presynth": true}
		var rc = Api.post_json("/chat", body, 30.0, false)
		var res: Dictionary = await rc.wait()
		if not res["ok"]:
			ok(false, "%s: /chat ok" % key)
			continue
		var t_recv: int = Time.get_ticks_usec()
		var d: Dictionary = res["data"]
		var chunks: Array = d.get("tts_chunks", [])
		started.clear()
		await Tts.speak_chunks(chunks, lang)
		var first_ms: float = (Time.get_ticks_usec() - t_recv) / 1000.0
		var tm: Dictionary = Tts.last_timing
		print("    %s: reply -> first sample playing %.0f ms  (request %.0f ms, decode %.1f ms)  chunks=%s" % [key, first_ms, tm.get("request_ms", -1.0), tm.get("decode_ms", -1.0), str(chunks)])
		await _wait_finished(30.0)
		var in_order := started.size() == chunks.size()
		for i in started.size():
			if int(started[i][0]) != i:
				in_order = false
		ok(in_order, "%s: all %d chunks played in order" % [key, chunks.size()])
		var no_overlap := true
		var max_gap := 0.0
		for i in range(1, started.size()):
			var prev_key: String = Tts.cache_key(str(started[i - 1][1]), lang, 1.0, Tts.voice_for(lang))
			var dur: float = WavUtil.duration(Tts._cache.get(prev_key))
			var gap: float = (int(started[i][2]) - int(started[i - 1][2])) / 1e6 - dur
			max_gap = maxf(max_gap, gap)
			if gap < 0.05:
				no_overlap = false
			print("      gap %d->%d: %.3f s" % [i - 1, i, gap])
		ok(no_overlap and max_gap < 0.9, "%s: no overlap, longest gap %.2f s" % [key, max_gap])
		# BEFORE-style: whole reply as one clip, no presynth
		var rb = Api.post_json("/chat", body.merged({"presynth": false}), 30.0, false)
		var rbr: Dictionary = await rb.wait()
		var full: String = str((rbr["data"] as Dictionary).get("reply", ""))
		var t2: int = Time.get_ticks_usec()
		await Tts.speak_chunks([full], lang)
		print("    %s BEFORE (one /tts for the whole reply): %.0f ms" % [key, (Time.get_ticks_usec() - t2) / 1000.0])
		await _wait_finished(30.0)
	Tts.chunk_started.disconnect(on_chunk)
