   "lines": [
    {
     "s": "A",
     "en": "Excuse me. Is there a washroom near here?",
     "ko": "저기요. 이 근처에 화장실이 있어요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "Yes, there is. It's in the library.",
     "ko": "네, 있어요. 도서관 안에 있어요.",
     "say": ""
    },
    {
     "s": "A",
     "en": "Where is the library?",
     "ko": "도서관이 어디예요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "It's on Main Street, next to the bank.",
     "ko": "메인 스트리트에, 은행 옆에 있어요.",
     "say": ""
    },
    {
     "s": "A",
     "en": "Is it far?",
     "ko": "멀어요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "No, it's near. It's on the left.",
     "ko": "아니요, 가까워요. 왼쪽에 있어요.",
     "say": ""
    },
    {
