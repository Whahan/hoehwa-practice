 ],
 "notes": [
  {
   "id": "n1001",
   "kind": "vocab",
   "text_ko": "캐나다에서 공공장소(식당·가게·공항)의 화장실은 washroom 이라고 해요. 집 안의 화장실은 bathroom 이라고도 해요. 미국에서 많이 쓰는 restroom 도 알아들으면 돼요.",
   "_cn": "cn_washroom"
  },
  {
   "id": "n1002",
   "kind": "spelling",
   "text_ko": "centre 는 캐나다 철자예요. 미국에서는 center 라고 써요. 정답 입력은 center 도 인정해요.",
   "ca": "centre",
   "us": "center",
   "_cn": "cn_centre"
  },
  {
   "id": "n1003",
   "kind": "vocab",
   "text_ko": "캐나다·미국에서 1층은 first floor 라고 해요. 큰 건물에서는 main floor 라고도 불러요."
  },
  {
   "id": "n1004",
   "kind": "culture",
   "text_ko": "캐나다 주소는 번지 숫자가 거리 이름 앞에 와요. 거리 이름은 Street, Avenue, Road 로 끝나는 경우가 많아요. 길을 물을 때는 거리 이름과 가게 이름을 같이 말하면 좋아요."
  },
  {
   "id": "n1005",
   "kind": "vocab",
   "text_ko": "downtown 은 도시의 중심가를 말해요. 은행·가게·식당이 모여 있는 곳이 많아서 길을 물을 때 자주 나와요."
  }
 ]
