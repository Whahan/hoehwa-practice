 "dialogues": [
  {
   "id": "d0015",
   "title_ko": "뭐 하고 있어요?",
   "scene": "right_now",
   "user": "B",
   "lines": [
    {
     "s": "A",
     "en": "Hi, Min. What are you doing?",
     "ko": "안녕하세요, 민. 뭐 하고 있어요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "I'm eating lunch.",
     "ko": "점심을 먹고 있어요.",
     "say": ""
    },
    {
     "s": "A",
     "en": "What are you eating?",
     "ko": "뭐 먹고 있어요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "I'm eating soup and bread. Are you hungry?",
     "ko": "수프하고 빵을 먹고 있어요. 배고파요?",
     "say": ""
    },
    {
     "s": "A",
     "en": "Yes, I'm hungry and tired.",
     "ko": "네, 배고프고 피곤해요.",
     "say": ""
    },
    {
     "s": "B",
     "en": "Why are you tired?",
     "ko": "왜 피곤해요?",
     "say": ""
    },
    {
     "s": "A",
     "en": "Because I work at night.",
     "ko": "밤에 일하니까요.",
     "say": ""
    },
    {
