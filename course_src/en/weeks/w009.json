 "dialogues": [
  {
   "id": "d0009",
   "title_ko": "하루 일과 이야기",
   "scene": "daily_time",
   "user": "B",
   "lines": [
    {
     "s": "A",
     "en": "Hi, Min. What time do you get up on Monday?",
     "ko": "안녕, 민. 월요일에는 몇 시에 일어나요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "I get up at six. What time do you get up?",
     "ko": "저는 여섯 시에 일어나요. 몇 시에 일어나요?",
     "say": ""
    },
    {
     "s": "A",
     "en": "I get up at seven. What time do you have breakfast?",
     "ko": "저는 일곱 시에 일어나요. 몇 시에 아침을 먹어요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "I have breakfast at seven. Do you have breakfast every day?",
     "ko": "저는 일곱 시에 아침을 먹어요. 매일 아침을 먹어요?",
     "say": ""
    },
    {
     "s": "A",
     "en": "Yes, I do. What time do you get up on Saturday?",
     "ko": "네, 먹어요. 토요일에는 몇 시에 일어나요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "I get up at nine on Saturday.",
     "ko": "저는 토요일에는 아홉 시에 일어나요.",
     "say": ""
    },
    {
     "s": "A",
     "en": "Nice. I get up at ten.",
     "ko": "좋겠네요. 저는 열 시에 일어나요.",
     "say": ""
    }
   ]
  }
 ],
 "notes": [
  {
   "id": "n0901",
   "kind": "culture",
   "text_ko": "캐나다에서는 말할 때 보통 12시간제를 써요. 오전·오후는 in the morning, in the evening 처럼 말해서 구분해요. 기차·버스 시간표에는 24시간제를 쓰기도 해요.",
   "_cn": "cn_12h"
  },
  {
   "id": "n0902",
   "kind": "vocab",
   "text_ko": "요일 이름은 문장 안에서도 항상 대문자로 써요: on Monday. 캐나다 달력은 일요일(Sunday)부터 시작하는 것이 많아서, 약속을 잡을 때 한 번 확인하면 좋아요."
  },
  {
   "id": "n0903",
   "kind": "vocab",
   "text_ko": "Have a good weekend. 는 금요일에 헤어질 때 하는 인사예요. 대답은 You too. 예요(You too 는 나중에 배워요). 지금은 Thanks. 라고 해도 돼요."
  },
  {
   "id": "n0904",
   "kind": "vocab",
   "text_ko": "캐나다·미국에서는 주말에 일어나는 일을 on the weekend 라고 해요. 영국에서는 at the weekend 라고 해서 전치사가 달라요."
  }
 ]
}
