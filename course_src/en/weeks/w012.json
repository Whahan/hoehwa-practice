 "dialogues": [
  {
   "id": "d0012",
   "title_ko": "못 알아들었을 때",
   "scene": "ask_again",
   "user": "B",
   "lines": [
    {
     "s": "A",
     "en": "Hi. Do you need help?",
     "ko": "안녕하세요. 도움이 필요하세요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "Sorry? Could you say that again, please?",
     "ko": "네? 다시 한번 말씀해 주시겠어요?",
     "say": ""
    },
    {
     "s": "A",
     "en": "Do you need help?",
     "ko": "도움이 필요하세요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "Oh, yes. I need a bag. I speak a little English.",
     "ko": "아, 네. 가방이 필요해요. 저는 영어를 조금 해요.",
     "say": ""
    },
    {
     "s": "A",
     "en": "No problem. I can help you. What colour?",
     "ko": "문제없어요. 제가 도와드릴 수 있어요. 무슨 색이요?",
     "say": ""
    },
    {
     "s": "B",
     "en": "Blue, please. Could you speak slowly?",
     "ko": "파란색으로 부탁해요. 천천히 말씀해 주시겠어요?",
     "say": ""
    },
    {
     "s": "A",
     "en": "Sure. Here is a blue bag.",
     "ko": "그럼요. 파란 가방 여기 있어요.",
     "say": ""
    },
    {
     "s": "B",
     "en": "Thank you. How much is it?",
     "ko": "감사해요. 얼마예요?",
     "say": ""
    },
    {
     "s": "A",
     "en": "It's $10.",
     "ko": "10달러예요.",
     "say": "It's ten dollars."
    }
   ]
  }
 ],
